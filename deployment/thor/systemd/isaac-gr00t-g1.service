[Unit]
Description=Official Isaac OS GR00T N1.7 and Agile WBC on G1
Requires=g1-camera-relay.service
After=g1-camera-relay.service

[Service]
Type=simple
WorkingDirectory=/home/thor/lbz_ws/g1_ws/isaac_os_ws/src/isaac-os
EnvironmentFile=/home/thor/lbz_ws/g1_ws/isaac_os_ws/src/isaac-os/deployment/thor/runtime.env
ExecStart=/home/thor/lbz_ws/g1_ws/isaac_os_ws/src/isaac-os/isaac_os run gr00t_n1_7_wbc_g1 real --img=isaac_os_build-gr00t_n1_7_wbc_g1:thor-a4ab23f --no-docker-build --no-local-build -- --config-path=deployment/thor/control.yaml --network-interface=enP2p1s0
KillSignal=SIGINT
SuccessExitStatus=130
TimeoutStopSec=30
Restart=no

[Install]
WantedBy=default.target
