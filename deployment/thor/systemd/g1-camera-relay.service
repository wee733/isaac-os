[Unit]
Description=G1 RealSense RGB over SSH to Thor V4L2
After=network-online.target
PartOf=isaac-gr00t-g1.service

[Service]
Type=exec
ExecStart=/bin/bash -o pipefail -c '/usr/bin/ssh -T -o BatchMode=yes -o ConnectTimeout=5 -o ConnectionAttempts=1 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 unitree@192.168.123.164 /usr/bin/gst-launch-1.0 -q v4l2src device=/dev/v4l/by-path/platform-3610000.xhci-usb-0:3:1.3-video-index0 ! video/x-raw,format=YUY2,width=640,height=480,framerate=30/1 ! queue max-size-buffers=2 leaky=downstream ! fdsink fd=1 sync=false | /usr/bin/ffmpeg -hide_banner -loglevel warning -f rawvideo -pixel_format yuyv422 -video_size 640x480 -framerate 30 -i pipe:0 -an -c:v copy -f v4l2 /dev/video42'
# V4L2 capture becomes available only after FFmpeg writes the first frame.
ExecStartPost=/bin/bash -c 'until /usr/bin/v4l2-ctl --device=/dev/video42 --get-fmt-video >/dev/null 2>&1; do /usr/bin/sleep 0.2; done; exec /usr/bin/ffmpeg -nostdin -hide_banner -loglevel error -f v4l2 -input_format yuyv422 -video_size 640x480 -framerate 30 -i /dev/video42 -frames:v 5 -f null -'
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
TimeoutStartSec=20

[Install]
WantedBy=default.target
